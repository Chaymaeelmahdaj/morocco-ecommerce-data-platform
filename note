# Check Python location
where.exe python


# ==========================================
# 3. GIT
# ==========================================

# Check Git
git --version

# If Git is not recognized:
$env:Path += ";C:\Program Files\Git\cmd"

# Check Git again
git --version

# Check Git repository
git status

# Initialize repository if needed
git init

# Add .gitignore
git add .gitignore

# Check status
git status


